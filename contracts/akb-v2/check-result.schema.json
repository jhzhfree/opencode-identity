{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AKB staged management check",
  "type": "object",
  "required": ["ok", "checks"],
  "properties": {
    "ok": {"type": "boolean", "description": "True only after actual authorized retrieval succeeds"},
    "checks": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "required": ["stage", "status", "code"],
        "properties": {
          "stage": {"enum": ["connection", "identity", "catalog", "retrieval"]},
          "status": {"enum": ["success", "failed", "not_checked", "not_required"]},
          "code": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  }
}
