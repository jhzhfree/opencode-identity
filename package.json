{
  "name": "opencode-identity-studio",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Generate and install Agent-authenticated AKB MCP plugins for OpenCode 1.x/2.x, with a local identity lab.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "server": "node bin/identity-server.mjs",
    "test": "node --test test/*.test.mjs packages/identity-sdk/test/*.test.mjs",
    "sdk:test": "node --test packages/identity-sdk/test/sdk.test.mjs",
    "sdk:selftest": "node packages/identity-sdk/bin/sdk.mjs selftest",
    "sdk:describe": "node packages/identity-sdk/bin/sdk.mjs describe",
    "akb": "node bin/akb-plugin.mjs",
    "check:contracts": "tsc --noEmit --allowJs --checkJs false --skipLibCheck --module nodenext --target es2022 lib/akb/plugin-v2.mjs",
    "test:akb-java": "node test/akb-java-interop.mjs",
    "test:bundle": "node test/akb-bundle-smoke.mjs"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.14.30",
    "@opencode/plugin": "2.2.5",
    "@types/node": "22.20.5",
    "effect": "4.0.0-beta.57",
    "jsonc-parser": "3.3.1",
    "typescript": "5.8.3"
  }
}
