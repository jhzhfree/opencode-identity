{
  "name": "opencode-identity",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "三个可分别启动的程序：插件生成工具（Web UI，含 AKB MCP 插件）、身份 SDK（CLI/库）、MCP 验签服务端。",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start:studio": "node apps/plugin-studio/server.mjs",
    "start:mcp": "node apps/mcp-server/bin/serve.mjs",
    "sdk": "node packages/identity-sdk/bin/sdk.mjs",
    "sdk:selftest": "node packages/identity-sdk/bin/sdk.mjs selftest",
    "sdk:describe": "node packages/identity-sdk/bin/sdk.mjs describe",
    "test": "node --test apps/plugin-studio/test/*.test.mjs apps/mcp-server/test/*.test.mjs packages/identity-sdk/test/*.test.mjs",
    "akb": "node apps/plugin-studio/bin/akb-plugin.mjs",
    "check:contracts": "tsc --noEmit --allowJs --checkJs false --skipLibCheck --module nodenext --target es2022 apps/plugin-studio/lib/akb/plugin-v2.mjs",
    "test:akb-java": "node apps/plugin-studio/test/akb-java-interop.mjs",
    "test:bundle": "node apps/plugin-studio/test/akb-bundle-smoke.mjs",
    "dist": "node scripts/build-dist.mjs"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.14.30",
    "@opencode/plugin": "2.2.5",
    "@types/node": "22.20.5",
    "effect": "4.0.0-beta.57",
    "jsonc-parser": "3.3.1",
    "typescript": "5.8.3"
  }
}
